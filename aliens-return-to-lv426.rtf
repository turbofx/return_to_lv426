\par \pard\plain \s0\rtlch\af7\afs24\alang1081 \ltrch\lang1033\langfe2052\hich\af3\loch\ql\widctlpar\hyphpar0\ltrpar\aspalpha\cf0\f3\fs24\lang1033\kerning1\dbch\af5\langfe2052\ql{\loch
